# Snowflake connection credentials — fill in the real values below,
# then rename this file to ".env" (remove the ".template" suffix).
# This file stays on your computer only — it is never sent anywhere
# except directly to Snowflake when the script connects.

SNOWFLAKE_ACCOUNT=your_account_identifier      # e.g. xy12345.us-east-1 or orgname-accountname
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse_name
SNOWFLAKE_ROLE=your_readonly_role_name         # e.g. a role granted only SELECT/USAGE privileges
SNOWFLAKE_DATABASE=                            # optional, leave blank to just browse everything
SNOWFLAKE_SCHEMA=                              # optional
